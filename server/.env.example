# GardenPlan configuration. database.js reads the first of these that exists:
#   1. the file named in the GARDENPLAN_ENV_FILE environment variable
#   2. /etc/gardenplan/gardenplan.env   (recommended on the Raspberry Pi)
#   3. server/.env                      (local development fallback)
# Values already set in the environment always win. Never commit the real file.
DB_HOST=localhost
DB_PORT=3306
DB_USER=gardenplan
DB_PASSWORD=
DB_NAME=gardenplan

# Port of the web app: http://<raspberry-ip>:8080
PORT=8080
