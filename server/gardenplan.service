# systemd service – GardenPlan starts automatically when the Raspberry Pi boots.
# Install:  sudo cp gardenplan.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now gardenplan
# Adjust User and the paths if the repository is not in /home/pi/GardenPlan.
[Unit]
Description=GardenPlan web app
After=network.target mariadb.service

[Service]
User=pi
WorkingDirectory=/home/pi/GardenPlan/server
ExecStart=/usr/bin/env node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
